# Copy values to backend/.env and frontend/.env.local as indicated in README.
# Never commit real credentials.

# Backend (backend/.env)
APP_ENV=development
APP_NAME=Personalized Travel Itinerary Planner
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./travel_planner.db
DEMO_MODE=true
LOG_LEVEL=INFO
MAX_TRIP_DAYS=21
MAX_GENERATION_REQUESTS_PER_MINUTE=8
REQUEST_TIMEOUT_SECONDS=30

# Optional server-side AI provider. Keep AI_API_KEY out of frontend VITE_ variables.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional Supabase integration. Local SQLite/demo mode works without these.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Frontend (frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
